<Window x:Class="VideoDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube &amp; TikTok Downloader" Height="840" Width="900" MinHeight="600" MinWidth="720"
        WindowStartupLocation="CenterScreen" Background="#0E0F1A" Foreground="#F1F1F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">
    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="CardBg" Color="#171929"/>
        <SolidColorBrush x:Key="CardBorder" Color="#272A45"/>
        <SolidColorBrush x:Key="InputBg" Color="#1F2238"/>
        <SolidColorBrush x:Key="Muted" Color="#9A9DBD"/>
        <SolidColorBrush x:Key="Violet" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="Pink" Color="#EC4899"/>
        <SolidColorBrush x:Key="Success" Color="#34D399"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C3AED" Offset="0"/>
            <GradientStop Color="#EC4899" Offset="0.55"/>
            <GradientStop Color="#F97316" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="0.5"/>
            <GradientStop Color="#EC4899" Offset="1"/>
        </LinearGradientBrush>

        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Input frame that glows when its textbox has focus -->
        <Style x:Key="InputFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,0"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Pink}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Borderless textbox with placeholder (placeholder text goes in Tag) -->
        <Style x:Key="PlainInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F1F1F7"/>
            <Setter Property="CaretBrush" Value="#F1F1F7"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Violet}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#6B6E8F"
                                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F1F1F7"/>
            <Setter Property="Background" Value="#252842"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="Hover" Background="White" CornerRadius="12" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource BrandGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Format chips (radio buttons that look like selectable cards) -->
        <Style x:Key="FormatChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F1F1F7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="GroupName" Value="Quality"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="14" Background="{StaticResource InputBg}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" Padding="8,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Violet}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandGradient}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gradient, rounded progress bar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5" Background="#252842"/>
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                    Background="{StaticResource ProgressGradient}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-shaped chip -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#252842"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ToggleLink" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- Soft colored glows in the background -->
        <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-240,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#557C3AED" Offset="0"/>
                    <GradientStop Color="#007C3AED" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-240,-260"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#44EC4899" Offset="0"/>
                    <GradientStop Color="#00EC4899" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18" MaxWidth="920">

                <!-- ============ Header ============ -->
                <Border CornerRadius="20" Background="{StaticResource BrandGradient}" Padding="22,16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" CornerRadius="14" Background="#33FFFFFF">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="26"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Video Downloader" FontSize="26" FontWeight="Bold" Foreground="White"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock Text="Save YouTube &amp; TikTok videos in one click" Foreground="#E6FFFFFF"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Pill}" Background="#33FFFFFF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="YouTube" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="#33FFFFFF" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC4F;" FontSize="11" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="TikTok" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ Link input ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="VIDEO LINK"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource InputFrame}" Height="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Foreground="{StaticResource Violet}"
                                               FontSize="16" Margin="0,0,12,0"/>
                                    <TextBox x:Name="UrlBox" Grid.Column="1" Style="{StaticResource PlainInput}"
                                             Tag="Paste or drop a YouTube / TikTok link here&#x2026;" KeyDown="UrlBox_KeyDown"/>
                                </Grid>
                            </Border>
                            <Button x:Name="PasteButton" Grid.Column="1" Style="{StaticResource BaseButton}" Margin="10,0,0,0"
                                    Height="48" Click="Paste_Click" ToolTip="Paste link from clipboard and preview it">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" Margin="0,0,8,0"/>
                                    <TextBlock Text="Paste"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="FetchButton" Grid.Column="2" Style="{StaticResource BaseButton}" Margin="10,0,0,0"
                                    Height="48" Click="Fetch_Click" ToolTip="Load video details (Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0"/>
                                    <TextBlock Text="Preview"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Preview ============ -->
                <Border Style="{StaticResource Card}" MinHeight="136">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#252842" HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyIcon" Style="{StaticResource Icon}" Text="&#xE714;" FontSize="22"
                                           Foreground="{StaticResource Pink}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EmptyText" Text="Your video preview will appear here"
                                       Foreground="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Loaded state -->
                        <Grid x:Name="PreviewContent" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="200" Height="112">
                                <Border CornerRadius="12" Background="{StaticResource BrandGradient}" Opacity="0.5"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="28" Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <Border x:Name="ThumbBorder" CornerRadius="12"/>
                                <Border x:Name="DurationBadge" CornerRadius="6" Background="#CC000000" Padding="6,2"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                                    <TextBlock x:Name="DurationText" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <Border x:Name="PlatformBadge" Style="{StaticResource Pill}" HorizontalAlignment="Left"
                                        Margin="0,0,0,8">
                                    <TextBlock x:Name="PlatformText" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="48"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="12"
                                               Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="UploaderText" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ Format + destination ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="FORMAT"/>
                        <UniformGrid x:Name="QualityPanel" Columns="5" Margin="0,0,-10,0">
                            <RadioButton Style="{StaticResource FormatChip}" Tag="Best" IsChecked="True">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Best" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="Top quality MP4" FontSize="11" Opacity="0.75" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FormatChip}" Tag="P1080">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="1080p" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="Full HD MP4" FontSize="11" Opacity="0.75" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FormatChip}" Tag="P720">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="720p" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="HD MP4" FontSize="11" Opacity="0.75" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FormatChip}" Tag="P480">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="480p" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="Small file MP4" FontSize="11" Opacity="0.75" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FormatChip}" Tag="AudioMp3">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Audio" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="MP3 only" FontSize="11" Opacity="0.75" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="SAVE TO" Margin="0,16,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource InputFrame}" Height="44">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="#F59E0B"
                                               FontSize="16" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Click="Browse_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Margin="0,0,8,0"/>
                                    <TextBlock Text="Change"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Download + progress ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Height="54" FontSize="16"
                                    Click="Download_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Download"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource BaseButton}" Height="54"
                                    Margin="10,0,0,0" IsEnabled="False" Click="Cancel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" Margin="0,0,8,0"/>
                                    <TextBlock Text="Cancel"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource BaseButton}" Height="54" Margin="10,0,0,0"
                                    Click="OpenFolder_Click" ToolTip="Open download folder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open folder"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PercentText" Text="0%" FontSize="28" FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Foreground="{StaticResource Muted}"
                                       Margin="14,0,0,6" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                <Border Style="{StaticResource Pill}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="11"
                                                   Foreground="#22D3EE" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="SpeedText" Text="&#x2014;" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="11"
                                                   Foreground="#F59E0B" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="EtaText" Text="&#x2014;" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100"/>
                    </StackPanel>
                </Border>

                <!-- ============ Details / log ============ -->
                <Grid>
                    <ToggleButton x:Name="LogToggle" Style="{StaticResource ToggleLink}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Show details"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="UpdateButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            Click="Update_Click" ToolTip="Update the download engine (fixes most download errors)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Update engine"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="4" Margin="0,6,0,0"
                        Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVis}}">
                    <TextBox x:Name="LogBox" Height="180" IsReadOnly="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#B8BAD6"
                             Background="Transparent" BorderThickness="0" Padding="10"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
